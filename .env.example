# RUC System local configuration template
# Copy this file to .env and replace every placeholder with local test values.
# Never commit .env.

# Preferred: use DATABASE_URL
# DATABASE_URL=postgresql://RUC_USER:RUC_PASSWORD@localhost:5432/ruc_system

# Alternative: use individual PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ruc_system
DB_USER=RUC_USER
DB_PASSWORD=RUC_PASSWORD

# Generate a long random value for each machine/test installation.
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Optional upload limit in bytes. Default is 16777216.
# MAX_UPLOAD_BYTES=16777216

# Runtime security defaults for local HTTP development.
# Use true only when serving through HTTPS.
RUC_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
RUC_SESSION_HOURS=8

# Keep false unless RUC is behind a trusted reverse proxy configured by the deployment stage.
RUC_TRUST_PROXY_HEADERS=false

# Windows Mini-PC production runtime. Keep localhost by default.
# For authorized LAN access, explicitly set RUC_HOST=0.0.0.0.
RUC_HOST=127.0.0.1
RUC_PORT=5000
RUC_THREADS=4

# Technical production logs. Never store secrets in log files.
RUC_LOG_DIR=logs
RUC_LOG_LEVEL=INFO

# Workbook safety controls.
WORKBOOK_LOCK_TIMEOUT_SECONDS=30
WORKBOOK_STALE_LOCK_SECONDS=3600
MASTER_TRACKER_PENDING_REMINDER_HOURS=24

# Login protection defaults. The limiter uses client IP plus browser user-agent.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_BLOCK_SECONDS=300
SECURITY_AUDIT_THROTTLE_SECONDS=60
