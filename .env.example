# RUC System local configuration template
# Copy this file to .env and replace every placeholder with local test values.
# Never commit .env.

# Preferred: use DATABASE_URL
# DATABASE_URL=postgresql://RUC_USER:RUC_PASSWORD@localhost:5432/ruc_system

# Alternative: use individual PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ruc_system
DB_USER=RUC_USER
DB_PASSWORD=RUC_PASSWORD

# Generate a long random value for each machine/test installation.
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Optional upload limit in bytes. Default is 16777216.
# MAX_UPLOAD_BYTES=16777216
